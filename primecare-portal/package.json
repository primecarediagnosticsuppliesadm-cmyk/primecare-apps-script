{
  "name": "primecare-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tenant-view && node scripts/verify-runtime-import-safety.mjs && vite build",
    "check:tenant-view": "node scripts/check-tenant-view-imports.mjs",
    "db:qa:check": "node scripts/assert-supabase-environment.mjs --expect=qa",
    "db:prod:check": "node scripts/assert-supabase-environment.mjs --expect=prod",
    "db:qa:dry-run": "node scripts/db-safe-dry-run.mjs --expect=qa",
    "db:prod:dry-run": "PRIMECARE_CONFIRM_PROD=YES node scripts/db-safe-dry-run.mjs --expect=prod",
    "certify:release": "node scripts/certify-release.mjs",
    "certify:release:quick": "CERTIFY_QUICK=1 CERTIFY_ALLOW_DIRTY=1 node scripts/certify-release.mjs",
    "verify:db-foundation": "node scripts/verify-db-foundation.mjs",
    "verify:notification-contract": "node scripts/verify-notification-contract.mjs",
    "verify:legacy-deps": "node scripts/verify-legacy-dependency-gate.mjs",
    "verify:git-release": "node scripts/verify-git-release-safety.mjs",
    "verify:qa-prod-parity": "node scripts/verify-qa-prod-parity.mjs",
    "verify:lab-ordering-1a": "node scripts/verify-lab-ordering-1a-security.mjs",
    "verify:lab-ordering-1b": "node scripts/verify-lab-ordering-1b-price-and-item-lockdown.mjs",
    "verify:lab-ordering-1c": "node scripts/verify-lab-ordering-1c-hq-order-search.mjs",
    "verify:lab-ordering-1f": "node scripts/verify-lab-ordering-1f-anon-order-lockdown.mjs",
    "enforce:pre-commit": "node scripts/enforcement/run-architecture-enforcement.mjs --profile pre-commit",
    "enforce:pr": "node scripts/enforcement/run-architecture-enforcement.mjs --profile pr --all",
    "enforce:full": "ENFORCEMENT_MODE=full node scripts/enforcement/run-architecture-enforcement.mjs --profile nightly --all",
    "enforce:health": "node scripts/enforcement/generate-health-dashboard.mjs",
    "enforce:validator": "node scripts/enforcement/run-architecture-enforcement.mjs --validator",
    "lint": "eslint .",
    "lint:runtime": "eslint -c eslint.runtime-safety.config.js src/pages src/components",
    "preview": "vite preview",
    "supabase:functions:serve": "supabase functions serve provision-platform-user reset-platform-user-password --env-file .env.functions.local",
    "supabase:functions:deploy:qa": "supabase functions deploy provision-platform-user reset-platform-user-password generate-invoice-pdf --project-ref zipuzmfkwwucbchlphcj"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
